# Options for the Atalaia service (read by systemd). Uncomment what you need, then:
#   sudo systemctl restart atalaia

# Address to listen on. The default (127.0.0.1:8080) is this machine only.
# For the whole local network use 0.0.0.0:8443 together with HTTPS below.
#ATALAIA_LISTEN=0.0.0.0:8443

# HTTPS with a self-signed certificate that Atalaia makes and renews (compare the fingerprint in the log):
#ATALAIA_TLS_SELF_SIGNED=1
# ...or your own certificate:
#ATALAIA_TLS_CERT=/etc/atalaia/cert.pem
#ATALAIA_TLS_KEY=/etc/atalaia/key.pem

# Behind a reverse proxy that terminates TLS, mark the session cookie Secure:
#ATALAIA_SECURE_COOKIES=1

# Observe only: turn off ping, Wake-on-LAN, port scans and exposure checks.
#ATALAIA_NO_ACTIVE_TOOLS=1

# Monitoring (see the "Monitoring" docs page):
# ping this URL after every scan, URL/fail when a scan fails (Healthchecks.io and similar; keep it secret):
#ATALAIA_HEARTBEAT_SCAN=https://hc-ping.com/your-uuid
# /metrics for Prometheus: put a token of 32+ characters in /etc/atalaia/metrics-token (root only, 0600:
#   openssl rand -hex 32 | sudo install -D -m 0600 /dev/stdin /etc/atalaia/metrics-token
# ) and hand it to the service as a credential, which the service user can read:
#   sudo systemctl edit atalaia   ->   [Service]
#                                     LoadCredential=metrics-token:/etc/atalaia/metrics-token
# GET /api/health answers without login (HTTP 503 when something is wrong) for Uptime Kuma and the like.

# Automatic backups (on by default): a copy of the database every day in /var/lib/atalaia/backups,
# keeping the newest 7, with a weekly restore test. They are on the same disk: copy them elsewhere too.
#ATALAIA_BACKUP_DIR=/var/lib/atalaia/backups
#ATALAIA_BACKUP_KEEP=7
# ping this URL after every automatic backup, URL/fail when it (or its restore test) fails:
#ATALAIA_HEARTBEAT_BACKUP=https://hc-ping.com/your-other-uuid
